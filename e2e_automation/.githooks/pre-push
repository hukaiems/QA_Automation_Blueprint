#!/bin/bash

# get the current branch first
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

PATTERN="^(feature|fix|bugfix|chore|hotfix|docs)\/[a-z0-9-]+$"

# skip the main branch to work locally
if [ "$BRANCH_NAME" = "main" ]; then
  echo "Skipping branch validation for main branch."
  exit 0
fi

# Validate the branch name against the pattern
if [[ ! "$BRANCH_NAME" =~ $PATTERN ]]; then
  echo "-------------------------------------------------------"
  echo "❌ ERROR: Invalid branch name: $BRANCH_NAME"
  echo "💡 Example: 'feature/login-test' or 'fix/xpath-error'"
  echo "Accepted prefixes: feature/, fix/, bugfix/, chore/, hotfix/, docs/"
  echo "-------------------------------------------------------"
  exit 1
fi