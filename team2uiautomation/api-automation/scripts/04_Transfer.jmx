            <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="Transfer Negatives case"/>
            <hashTree>
              <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Loop each negative test case">
                <stringProp name="LoopController.loops">11</stringProp>
              </LoopController>
              <hashTree>
                <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV Data Set Config">
                  <stringProp name="filename">../test-data/transfer_negative.csv</stringProp>
                  <stringProp name="fileEncoding">UTF-8</stringProp>
                  <stringProp name="variableNames">test_case,amount,password,target_id,from_account,to_account,expected_status,expected_message,balance_1,balance_2,token,check_receiver_balance,bearer_token</stringProp>
                  <boolProp name="ignoreFirstLine">true</boolProp>
                  <stringProp name="delimiter">,</stringProp>
                  <boolProp name="quotedData">true</boolProp>
                  <boolProp name="recycle">false</boolProp>
                  <boolProp name="stopThread">false</boolProp>
                  <stringProp name="shareMode">shareMode.all</stringProp>
                </CSVDataSet>
                <hashTree/>
                <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="${test_case}">
                  <boolProp name="TransactionController.parent">true</boolProp>
                  <boolProp name="TransactionController.includeTimers">false</boolProp>
                </TransactionController>
                <hashTree>
                  <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
                    <collectionProp name="HeaderManager.headers">
                      <elementProp name="" elementType="Header">
                        <stringProp name="Header.name">authorization</stringProp>
                        <stringProp name="Header.value">Bearer ${__eval(${bearer_token})}</stringProp>
                      </elementProp>
                    </collectionProp>
                  </HeaderManager>
                  <hashTree/>
                  <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Transfer call">
                    <stringProp name="HTTPSampler.path">api/account/transfer/${__eval(${from_account})}/${__eval(${to_account})}</stringProp>
                    <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
                    <stringProp name="HTTPSampler.method">PUT</stringProp>
                    <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                    <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
                    <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                      <collectionProp name="Arguments.arguments">
                        <elementProp name="" elementType="HTTPArgument">
                          <boolProp name="HTTPArgument.always_encode">false</boolProp>
                          <stringProp name="Argument.value">{&#xd;
    &quot;balanceTransfered&quot;: ${amount},&#xd;
    &quot;token&quot;: &quot;${__eval(${token})}&quot;,&#xd;
    &quot;oldPassword&quot;: &quot;${password}&quot;,&#xd;
    &quot;id&quot;: &quot;${__eval(${target_id})}&quot;,&#xd;
    &quot;from&quot;: &quot;${__eval(${from_account})}&quot;,&#xd;
    &quot;to&quot;: &quot;${__eval(${to_account})}&quot;&#xd;
}</stringProp>
