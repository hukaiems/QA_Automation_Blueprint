                    <stringProp name="Argument.value">{&#xd;
    &quot;balanceTransfered&quot;: 50,&#xd;
    &quot;token&quot;: &quot;${user_token_one}&quot;,&#xd;
    &quot;oldPassword&quot;: &quot;P@ssw0rdP@ssw0rd&quot;,&#xd;
    &quot;id&quot;: &quot;${user_id_one}&quot;,&#xd;
    &quot;from&quot;: &quot;${account_id_1}&quot;,&#xd;
    &quot;to&quot;: &quot;${account_id_2}&quot;&#xd;
}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
